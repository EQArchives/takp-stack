###########################################################
# Your server
# LOCAL_ADDRESS: how players on this machine or your home network reach
#   the server. 127.0.0.1 = this machine only. For LAN play, use this
#   machine's LAN IP (e.g. 192.168.1.50).
# PUBLIC_ADDRESS: your public IP, for players over the internet.
#   Leave empty if you're not hosting for the internet.
# Changes apply on restart: docker compose up -d
###########################################################
SERVER_LONG_NAME=My TAKP Server
SERVER_SHORT_NAME=mytakp
SERVER_LOCAL_ADDRESS=127.0.0.1
SERVER_PUBLIC_ADDRESS=

###########################################################
# Drivers
###########################################################
NETWORKS_DRIVER=bridge

###########################################################
# MySQL
###########################################################
MARIADB_DATABASE=peq
MARIADB_USER=eqemu
MARIADB_PASSWORD=<template>
MARIADB_PORT=3306
MARIADB_EXTERNAL_PORT=3307
MARIADB_ROOT_PASSWORD=<template>
DATA_PATH_HOST=./data

###########################################################
# Other settings
###########################################################
# Pull the latest server code, quests, and maps on every start.
# Off by default so a restart never changes your server. To update on
# purpose, see "Updates" in the README.
AUTO_PULL=false

# Hostname inside the takp-server container (shell prompt, logs).
# Not your server's public name. See SERVER_* above for that.
CONTAINER_HOSTNAME=takp-server

# User and group IDs that own files in server/ and source/ on the host.
# Set to the output of `id -u` and `id -g` (usually 1000). Not 0, and
# PGID must not match an existing group in the image (e.g. 100).
# Rootless Docker: leave at 1000; see "Editing config files" in the README.
PUID=1000
PGID=1000

# Where to get the server source, quests, and maps and which branch (empty = the repo's default).
# Used only for the first download; see "Using your own fork" in the README
# to switch an existing install.
SOURCE_REPO=https://github.com/EQMacEmu/Server.git
SOURCE_BRANCH=
QUESTS_REPO=https://github.com/EQMacEmu/quests.git
QUESTS_BRANCH=
MAPS_REPO=https://github.com/EQMacEmu/Maps.git
MAPS_BRANCH=

IP_ADDRESS=0.0.0.0
CC=/usr/bin/gcc
CXX=/usr/bin/g++

###########################################################
# Telnet console
# Applied on every start (docker compose up -d).
###########################################################
TELNET_ENABLED=false

###########################################################
# Developer/admin ports
# Default 127.0.0.1 = reachable only from this machine.
# Set to 0.0.0.0 to expose to the network.
###########################################################
SSH_BIND=127.0.0.1
LOGIN_TCP_BIND=127.0.0.1
TELNET_BIND=127.0.0.1
WORLD_TCP_BIND=127.0.0.1
MARIADB_BIND=127.0.0.1

#############################################################
# Zone ports
# World assigns each zone a port from this range, and the range is
# published to players. Keep it larger than the number of enabled zones
# (launcher_zones.enabled). Default: 30 zones in 31 ports.
# For more zones: enable them in launcher_zones, raise PORT_RANGE_HIGH,
# then run: docker compose up -d. The server's zone port pool follows
# this range automatically.
#############################################################
PORT_RANGE_LOW=7000
PORT_RANGE_HIGH=7030

###########################################################
# Timezone
# Standard names only: UTC, America/New_York, Europe/London, etc.
# Old names like US/Eastern don't work in the takp-server image.
###########################################################
TZ=UTC

###########################################################
# SSH access to takp-server (optional)
# Paste your PUBLIC key (the contents of ~/.ssh/id_ed25519.pub,
# one line starting with ssh-ed25519 or ssh-rsa). Never your private key.
# Leave empty to disable SSH logins.
###########################################################
SSH_AUTHORIZED_KEYS=

