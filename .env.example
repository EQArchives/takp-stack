###########################################################
# Your server
# LOCAL_ADDRESS: how players on this machine or your home network reach
#   the server. 127.0.0.1 = this machine only. For LAN play, use this
#   machine's LAN IP (e.g. 192.168.1.50).
# PUBLIC_ADDRESS: your public IP, for players over the internet.
#   Leave empty if you're not hosting for the internet.
# Changes apply on restart: docker compose up -d
###########################################################
SERVER_LONG_NAME=The EQArchives Project
SERVER_SHORT_NAME=eqarchives
SERVER_LOCAL_ADDRESS=127.0.0.1
SERVER_PUBLIC_ADDRESS=

###########################################################
# Drivers
###########################################################
NETWORKS_DRIVER=bridge

###########################################################
# MySQL
###########################################################
DATA_PATH_HOST=./data

# Memory MariaDB uses to cache the database. More is faster; keep it well
# under your machine's RAM. Changes need: docker compose up -d --build mariadb
INNODB_BUFFER_POOL_SIZE=256MB

MARIADB_DATABASE=peq
MARIADB_USER=eqemu
MARIADB_PASSWORD=<template>
# Port MariaDB listens on inside the stack. The server's config files follow it
# on every start. Changes need: docker compose up -d --build mariadb
MARIADB_PORT=3306
# Port on this machine for reaching MariaDB from outside Docker (see MARIADB_BIND).
MARIADB_EXTERNAL_PORT=3307
MARIADB_ROOT_PASSWORD=<template>

###########################################################
# Other settings
###########################################################
# Pull the latest server code, quests, and maps on every start.
# Off by default so a restart never changes your server. To update on
# purpose, see "Updates" in the README.
AUTO_PULL=false

# Hostname inside the takp-server container (shell prompt, logs).
# Not your server's public name. See SERVER_* above for that.
CONTAINER_HOSTNAME=eqa-server

CC=/usr/bin/gcc
CXX=/usr/bin/g++
IP_ADDRESS=0.0.0.0

# User and group IDs that own files in server/ and source/ on the host.
# Set to the output of `id -u` and `id -g` (usually 1000). Not 0, and
# PGID must not match an existing group in the image (e.g. 100).
# Rootless Docker: leave at 1000; see "Editing config files" in the README.
PUID=1000
PGID=1000

# Where to get the server source, quests, and maps and which branch (empty = the repo's default).
# Used only for the first download; see "Using your own fork" in the README
# to switch an existing install.
MAPS_REPO=https://github.com/EQArchives/Maps.git
MAPS_BRANCH=
QUESTS_REPO=https://github.com/EQArchives/quests.git
QUESTS_BRANCH=
SOURCE_REPO=https://github.com/EQArchives/Server.git
SOURCE_BRANCH=

# Space the compiler cache may use (makes rebuilds fast). Lower it on a small
# disk, e.g. 1G. Units: M or G.
CCACHE_MAXSIZE=5G

# How the server is compiled: RelWithDebInfo (default), Release, or Debug.
# Changing it triggers a rebuild on the next start.
CMAKE_BUILD_TYPE=RelWithDebInfo

# Extra CMake options for the server build, separated by spaces
# (e.g. -DEQEMU_BUILD_PERL=OFF). Changing them triggers a rebuild.
CMAKE_EXTRA_ARGS=

###########################################################
# Telnet console
# Applied on every start (docker compose up -d).
###########################################################
TELNET_ENABLED=false

###########################################################
# Developer/admin ports
# Default 127.0.0.1 = reachable only from this machine.
# Set to 0.0.0.0 to expose to the network.
###########################################################
SSH_BIND=127.0.0.1
LOGIN_TCP_BIND=127.0.0.1
TELNET_BIND=127.0.0.1
WORLD_TCP_BIND=127.0.0.1
MARIADB_BIND=127.0.0.1

#############################################################
# Zone ports
# World assigns each zone a port from this range, and the range is
# published to players. Keep it larger than the number of enabled zones
# (launcher_zones.enabled). Default: 30 zones in 31 ports.
# For more zones: enable them in launcher_zones, raise PORT_RANGE_HIGH,
# then run: docker compose up -d. The server's zone port pool follows
# this range automatically.
#############################################################
PORT_RANGE_LOW=7000
PORT_RANGE_HIGH=7400

###########################################################
# Timezone
# Standard names only: UTC, America/New_York, Europe/London, etc.
# Old names like US/Eastern don't work in the takp-server image.
###########################################################
TZ=UTC

###########################################################
# SSH access to takp-server (optional)
# Paste your PUBLIC key (the contents of ~/.ssh/id_ed25519.pub,
# one line starting with ssh-ed25519 or ssh-rsa). Never your private key.
# Leave empty to disable SSH logins.
###########################################################
SSH_AUTHORIZED_KEYS=

###########################################################
# Optional tools
# Turn tools on by listing them, separated by commas:
#   COMPOSE_PROFILES=players
# Then run: docker compose up -d
###########################################################
COMPOSE_PROFILES=

###########################################################
# Players website (profile: players)
# Magelo, item and NPC lookups, and login account registration.
# Reachable at http://127.0.0.1:8000 unless PLAYERS_BIND/PLAYERS_PORT change.
###########################################################
PLAYERS_REPO=https://github.com/nazwadi/EQMacEmu_Players.git
PLAYERS_BRANCH=main

# Generate each with: openssl rand -hex 32
PLAYERS_SECRET_KEY=
PLAYERS_DB_PASSWORD=

# The loginserver's password salt. Print it with:
#   docker compose exec takp-server jq -r .database.salt /home/eqemu/server/login.json
# Leave empty if it prints nothing. If it doesn't match, accounts made on the website can't log in.
PLAYERS_LS_PASSWORD_SALT=

# The site's public address, and the hostnames it answers to.
PLAYERS_SITE_URL=http://localhost:8000
PLAYERS_ALLOWED_HOSTS=localhost,127.0.0.1
PLAYERS_CSRF_TRUSTED_ORIGINS=

PLAYERS_BIND=127.0.0.1
PLAYERS_PORT=8000
PLAYERS_DB_NAME=players
PLAYERS_DB_USER=players
PLAYERS_DEBUG=FALSE
